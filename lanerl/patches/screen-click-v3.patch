+        /// <summary>
+        /// screen-click-v3: a click on unwalkable ground (walls, the map's edge, the void
+        /// past it) means "go to the closest reachable point", as the real client does.
+        /// Before this, GetPath returned null for such points and the fallback below
+        /// walked the champion in a straight line INTO the wall; a trained policy sent
+        /// 46-54% of its movement clicks there and hugged the map edge.
+        /// </summary>
+        private static Vector2 Reachable(Game game, Champion champ, Vector2 point)
+        {
+            var grid = game.Map.NavigationGrid;
+            point.X = Math.Clamp(point.X, grid.MinGridPosition.X, grid.MaxGridPosition.X);
+            point.Y = Math.Clamp(point.Y, grid.MinGridPosition.Z, grid.MaxGridPosition.Z);
+            if (grid.IsWalkable(point, champ.PathfindingRadius)) return point;
+            return grid.GetClosestTerrainExit(point, champ.PathfindingRadius);
+        }
+
