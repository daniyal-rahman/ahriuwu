+        private static int Bits(float v)
+        {
+            return BitConverter.SingleToInt32Bits(v);
+        }
+
+        private static string PrivateField(object obj, string name, float scale = 1f)
+        {
+            if (obj == null) return "-";
+            try
+            {
+                var f = obj.GetType().GetField(name,
+                    BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.Public);
+                if (f == null) return "-";
+                var v = f.GetValue(obj);
+                if (v is float fv) return Q(fv, scale).ToString(CultureInfo.InvariantCulture);
+                if (v is int iv) return iv.ToString(CultureInfo.InvariantCulture);
+                if (v is bool bv) return bv ? "1" : "0";
+                if (v is System.Collections.IDictionary d) return d.Count.ToString(CultureInfo.InvariantCulture);
+            }
+            catch { }
+            return "-";
+        }
+
+        private static object PrivateMember(object obj, string name)
+        {
+            if (obj == null) return null;
+            try
+            {
+                var flags = BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.Public;
+                var f = obj.GetType().GetField(name, flags);
+                if (f != null) return f.GetValue(obj);
+                var p = obj.GetType().GetProperty(name, flags);
+                if (p != null) return p.GetValue(obj);
+            }
+            catch { }
+            return null;
+        }
+
+        // Full identities are required here: a count cannot reconstruct either
+        // LaneMinionAI's 500 ms ignore expiry or its call-for-help priority.
+        private static string PrivateDictionary(object obj, string name, bool valuesAreFloats)
+        {
+            var value = PrivateMember(obj, name);
+            if (!(value is System.Collections.IDictionary dict)) return "-";
+            var rows = new List<string>();
+            foreach (System.Collections.DictionaryEntry pair in dict)
+            {
+                uint id;
+                if (pair.Key is AttackableUnit unit) id = unit.NetId;
+                else if (pair.Key is uint raw) id = raw;
+                else continue;
+                string v;
+                if (valuesAreFloats && pair.Value is float f)
+                    v = Q(f, StatQ).ToString(CultureInfo.InvariantCulture);
+                else
+                    v = Convert.ToInt32(pair.Value, CultureInfo.InvariantCulture)
+                        .ToString(CultureInfo.InvariantCulture);
+                rows.Add(id.ToString(CultureInfo.InvariantCulture) + ":" + v);
+            }
+            rows.Sort(StringComparer.Ordinal);
+            return rows.Count == 0 ? "none" : string.Join(",", rows);
+        }
